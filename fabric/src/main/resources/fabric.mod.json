{
	"schemaVersion": 1,
	"id": "forgemark",
	"version": "${version}",
	"name": "Forgemark",
	"description": "Temper the tools, weapons and armour you already have, from any mod, at a hearth and forging anvil, for a small, capped quality bonus. Crafting is left alone.",
	"icon": "assets/forgemark/icon.png",
	"authors": [
		"Gabby"
	],
	"contact": {
		"homepage": "https://github.com/gabmaybelle/forgemark",
		"sources": "https://github.com/gabmaybelle/forgemark",
		"issues": "https://github.com/gabmaybelle/forgemark/issues"
	},
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.gabbymaybelle.forgemark.fabric.ForgemarkFabric"
		],
		"client": [
			"com.gabbymaybelle.forgemark.fabric.client.ForgemarkFabricClient"
		],
		"jade": [
			"com.gabbymaybelle.forgemark.compat.JadePlugin"
		],
		"jei_mod_plugin": [
			"com.gabbymaybelle.forgemark.compat.JeiPlugin"
		],
		"rei_client": [
			"com.gabbymaybelle.forgemark.compat.ReiPlugin"
		]
	},
	"mixins": [
		"forgemark.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.15.11",
		"fabric-api": ">=0.116.0",
		"minecraft": "1.21.1",
		"java": ">=21"
	}
}
